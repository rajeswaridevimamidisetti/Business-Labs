GEMINI_API_KEY=replace-with-server-side-gemini-key
GEMINI_MODEL=gemini-3.5-flash-lite
TASK1_BASE_URL=http://127.0.0.1:8001
TASK2_DATABASE_URL=sqlite://data/local/task2.sqlite3
# Prefer the downloaded Web application JSON outside this repository.
GOOGLE_OAUTH_CLIENT_JSON_PATH=C:\Users\<YOUR_WINDOWS_USERNAME>\AppData\Local\Business-Labs\google-oauth-client.json
GOOGLE_OAUTH_CLIENT_ID=replace-with-google-web-client-id
GOOGLE_OAUTH_CLIENT_SECRET=replace-with-google-client-secret
GOOGLE_OAUTH_REDIRECT_URI=http://127.0.0.1:8002/v1/gmail/oauth/callback
# Google OpenID Connect login for the Business-Labs workspace.
GOOGLE_OIDC_CLIENT_ID=replace-with-google-web-client-id
GOOGLE_OIDC_CLIENT_SECRET=replace-with-google-client-secret
GOOGLE_OIDC_REDIRECT_URI=http://127.0.0.1:8002/v1/auth/callback
GOOGLE_OIDC_ISSUER=https://accounts.google.com
FRONTEND_URL=http://127.0.0.1:5173
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
GMAIL_TOKEN_ENCRYPTION_KEY=replace-with-base64-32-byte-key
GMAIL_TOKEN_PATH=data/local/gmail-tokens.enc
GMAIL_SYNC_PATH=data/local/gmail-sync.json
GMAIL_LIVE_SEND_ENABLED=false
# Required in deployments: long random secret used only to sign the server's HttpOnly session cookie.
TASK2_AUTH_SIGNING_SECRET=replace-with-long-random-session-secret
